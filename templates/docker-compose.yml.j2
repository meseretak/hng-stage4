networks:
  {{ network_name }}:
    driver: {{ network_driver }}

volumes:
  app_logs:

services:
  app:
    image: {{ app_image }}
    container_name: swiftdeploy-app
    restart: {{ app_restart }}
    environment:
      MODE: "{{ mode }}"
      APP_VERSION: "{{ app_version }}"
      APP_PORT: "{{ app_port }}"
    volumes:
      - app_logs:/app/logs
    networks:
      - {{ network_name }}
    expose:
      - "{{ app_port }}"
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    read_only: false
    security_opt:
      - no-new-privileges:true
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:{{ app_port }}/healthz"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 10s

  nginx:
    image: {{ nginx_image }}
    container_name: swiftdeploy-nginx
    restart: unless-stopped
    ports:
      - "{{ nginx_port }}:{{ nginx_port }}"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - app_logs:/var/log/nginx
    networks:
      - {{ network_name }}
    depends_on:
      app:
        condition: service_healthy
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true
